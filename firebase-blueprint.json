{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Shared equipment development workspace for the 5-engineer team (3-Cam Vision, Articulated Robot, PLC, Monitoring PC).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Project workspace display name"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Brief summary of the target automated cell line"
        },
        "targetDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10,
          "description": "Target FAT/delivery date (YYYY-MM-DD)"
        },
        "inviteCode": {
          "type": "string",
          "pattern": "^[A-Z0-9]{6}$",
          "maxLength": 6,
          "description": "6-character uppercase alphanumeric invite code for team members"
        },
        "lastJoinCode": {
          "type": "string",
          "pattern": "^[A-Z0-9]{6}$",
          "maxLength": 6,
          "description": "Invite code supplied during the most recent member join action"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the project creator"
        },
        "memberUids": {
          "type": "array",
          "description": "Bounded list of authenticated member UIDs (max 10)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated"
        }
      },
      "required": [
        "name",
        "description",
        "targetDate",
        "inviteCode",
        "lastJoinCode",
        "ownerId",
        "memberUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectInvite": {
      "title": "ProjectInvite",
      "description": "Lookup document keyed by 6-character inviteCode to allow team members to locate and join a project without listing projects.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Target project document ID"
        },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the target project"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the creator who issued this invite"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        }
      },
      "required": [
        "projectId",
        "projectName",
        "ownerId",
        "createdAt"
      ]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Engineering role slot and claimed teammate profile within a project (no PII stored).",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Claimed user UID or empty string for unclaimed preset slot"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "enum": ["PM", "VISION", "ROBOT", "PLC", "UI"]
        },
        "specialty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "isClaimed": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "uid",
        "displayName",
        "role",
        "specialty",
        "isClaimed",
        "updatedAt"
      ]
    },
    "ChecklistItem": {
      "title": "ChecklistItem",
      "description": "Module-specific engineering verification checklist item (Vision, Robot, PLC, UI) synced with overall dashboard progress.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "module": {
          "type": "string",
          "enum": ["VISION", "ROBOT", "PLC", "UI"]
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "isInterface": {
          "type": "boolean"
        },
        "interfacePair": {
          "type": "string",
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["todo", "in_progress", "done"]
        },
        "assigneeRole": {
          "type": "string",
          "enum": ["PM", "VISION", "ROBOT", "PLC", "UI"]
        },
        "assigneeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "dueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "sortOrder": {
          "type": "number"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "module",
        "stage",
        "isInterface",
        "interfacePair",
        "title",
        "status",
        "assigneeRole",
        "assigneeName",
        "dueDate",
        "notes",
        "sortOrder",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "RocChange": {
      "title": "RocChange",
      "description": "Record of Change (ROC) and engineering specification revision record with impact modules and approval status.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "pattern": "^ROC-\\d{3,4}$",
          "maxLength": 12
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "asIs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "toBe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "impactModules": {
          "type": "array",
          "description": "Affected engineering modules (1 to 5 items from VISION, ROBOT, PLC, UI, MECH)"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "on_hold", "rejected"]
        },
        "requesterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "requesterRole": {
          "type": "string",
          "enum": ["PM", "VISION", "ROBOT", "PLC", "UI"]
        },
        "reviewerName": {
          "type": "string",
          "maxLength": 60
        },
        "reviewComment": {
          "type": "string",
          "maxLength": 1000
        },
        "targetApplyDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "code",
        "title",
        "asIs",
        "toBe",
        "reason",
        "impactModules",
        "status",
        "requesterName",
        "requesterRole",
        "reviewerName",
        "reviewComment",
        "targetApplyDate",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Issue": {
      "title": "Issue",
      "description": "Open technical issue tracked across engineering modules that can be atomically converted into a Decision. Includes optional externalRef for deterministic pipeline import deduplication.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "pattern": "^ISS-\\d{3,4}$",
          "maxLength": 12
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "module": {
          "type": "string",
          "enum": ["VISION", "ROBOT", "PLC", "UI", "SYSTEM"]
        },
        "priority": {
          "type": "string",
          "enum": ["blocker", "high", "medium"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_review", "resolved"]
        },
        "assigneeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "assigneeRole": {
          "type": "string",
          "enum": ["PM", "VISION", "ROBOT", "PLC", "UI"]
        },
        "dueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "linkedDecisionId": {
          "type": "string",
          "maxLength": 128
        },
        "linkedDecisionCode": {
          "type": "string",
          "maxLength": 16
        },
        "externalRef": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional external pipeline reference key for deterministic import deduplication"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "code",
        "title",
        "description",
        "module",
        "priority",
        "status",
        "assigneeName",
        "assigneeRole",
        "dueDate",
        "linkedDecisionId",
        "linkedDecisionCode",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Decision": {
      "title": "Decision",
      "description": "Confirmed engineering decision record, optionally linked to the resolved source issue.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "pattern": "^DEC-\\d{3,4}$",
          "maxLength": 12
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "decisionSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "impactModules": {
          "type": "array",
          "description": "Affected modules (1 to 5 items from VISION, ROBOT, PLC, UI, MECH)"
        },
        "decidedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "decidedDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "sourceIssueId": {
          "type": "string",
          "maxLength": 128
        },
        "sourceIssueCode": {
          "type": "string",
          "maxLength": 16
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "code",
        "title",
        "decisionSummary",
        "rationale",
        "impactModules",
        "decidedByName",
        "decidedDate",
        "sourceIssueId",
        "sourceIssueCode",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "MachineInventory": {
      "title": "MachineInventory",
      "description": "Tracked cell hardware inventory entry (WS-01, NB-01, MINI-01, EC1~3, MON-01, PLC-01) with Git commit and backup tracking (no secrets or credentials).",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "machineCode": {
          "type": "string",
          "pattern": "^[A-Z0-9\\-]{2,16}$",
          "minLength": 2,
          "maxLength": 16
        },
        "category": {
          "type": "string",
          "enum": ["WORKSTATION", "LAPTOP", "MINI_PC", "EDGE_VISION", "ROBOT", "PLC", "MONITORING"]
        },
        "hostnameModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "osFirmware": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "runtimeEnv": {
          "type": "string",
          "maxLength": 100
        },
        "networkLabel": {
          "type": "string",
          "maxLength": 60
        },
        "nasBackupPath": {
          "type": "string",
          "maxLength": 160
        },
        "lastBackupDate": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
          "maxLength": 10
        },
        "gitCommitRef": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._/\\-]{0,60}$",
          "maxLength": 60
        },
        "recipeVersion": {
          "type": "string",
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["planned", "mock", "commissioning", "deployed", "maintenance"]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "sortOrder": {
          "type": "number"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "machineCode",
        "category",
        "hostnameModel",
        "osFirmware",
        "runtimeEnv",
        "networkLabel",
        "nasBackupPath",
        "lastBackupDate",
        "gitCommitRef",
        "recipeVersion",
        "status",
        "notes",
        "sortOrder",
        "updatedBy",
        "updatedAt"
      ]
    },
    "QualityGateRun": {
      "title": "QualityGateRun",
      "description": "Immutable Gate 1 (ruff/ruffFormat/mypy/pytest) and Gate 2 (vLLM review) summary report with strict security_local_only enforcement.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "runCode": {
          "type": "string",
          "pattern": "^QG-\\d{3,4}$",
          "maxLength": 12
        },
        "gitRef": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._/\\-]{1,60}$",
          "minLength": 1,
          "maxLength": 60
        },
        "reportedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "gate1Status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIPPED"]
        },
        "gate1Checks": {
          "type": "object",
          "description": "Fixed 4-key map: ruff (from ruff-check), ruffFormat (from ruff-format), mypy, pytest"
        },
        "gate2Verdict": {
          "type": "string",
          "enum": ["PASS", "WARN", "FAIL", "SKIPPED"]
        },
        "gate2Model": {
          "type": "string",
          "maxLength": 80
        },
        "reviewedFileCount": {
          "type": "number"
        },
        "securityLocalOnly": {
          "type": "boolean"
        },
        "findingCounts": {
          "type": "object",
          "description": "Fixed 5-key severity map: critical, high, medium, low, info"
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "runCode",
        "gitRef",
        "reportedAt",
        "gate1Status",
        "gate1Checks",
        "gate2Verdict",
        "gate2Model",
        "reviewedFileCount",
        "securityLocalOnly",
        "findingCounts",
        "summary",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Top-level shared project workspace document containing membership list and invite code"
    },
    "/invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/ProjectInvite" },
      "description": "Invite lookup table keyed by 6-char uppercase alphanumeric code"
    },
    "/projects/{projectId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "5-engineer role roster (PM, Vision, Robot, PLC, UI)"
    },
    "/projects/{projectId}/checklists/{itemId}": {
      "schema": { "$ref": "#/entities/ChecklistItem" },
      "description": "Module engineering checklists driving automated progress metrics"
    },
    "/projects/{projectId}/rocChanges/{rocId}": {
      "schema": { "$ref": "#/entities/RocChange" },
      "description": "ROC and specification revision history with approval workflow"
    },
    "/projects/{projectId}/issues/{issueId}": {
      "schema": { "$ref": "#/entities/Issue" },
      "description": "Open technical issues with optional externalRef deduplication and atomic conversion to decisions"
    },
    "/projects/{projectId}/decisions/{decisionId}": {
      "schema": { "$ref": "#/entities/Decision" },
      "description": "Confirmed engineering decisions linked to source issues"
    },
    "/projects/{projectId}/machines/{machineId}": {
      "schema": { "$ref": "#/entities/MachineInventory" },
      "description": "8-unit cell hardware inventory (WS-01, NB-01, MINI-01, EC1~3, MON-01, PLC-01)"
    },
    "/projects/{projectId}/qualityGates/{runId}": {
      "schema": { "$ref": "#/entities/QualityGateRun" },
      "description": "Immutable Gate 1/2 automated quality verification summary records"
    }
  }
}
